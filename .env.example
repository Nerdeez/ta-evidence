# Local development — copy to .env and adjust as needed.
# Matches credentials in compose.yaml (postgres service).
DATABASE_URL=postgresql://ta_evidence:ta_evidence@localhost:15432/ta_evidence

# Better Auth (@ta/auth) — https://better-auth.com/docs/installation
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

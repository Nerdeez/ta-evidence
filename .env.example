# Local development — copy to .env and adjust as needed.
# Matches credentials in compose.yaml (postgres service).
DATABASE_URL=postgresql://ta_evidence:ta_evidence@localhost:15432/ta_evidence

# Better Auth (@ta/auth) — https://better-auth.com/docs/installation
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Public origin of @ta/web-strategies — Better Auth trustedOrigins (@ta/auth)
NEXT_PUBLIC_WEB_STRATEGIES_URL=http://localhost:3000

# Open Code Review (`pnpm code-review`) — https://github.com/alibaba/open-code-review
OCR_LLM_URL=https://api.openai.com/v1
OCR_LLM_TOKEN=
OCR_LLM_MODEL=gpt-5.4
OCR_LLM_PROTOCOL=openai-responses
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug @ta/api-strategies (all tests)",
      "cwd": "${workspaceFolder}/apps/api/strategies",
      "runtimeExecutable": "${env:HOME}/.local/bin/mise",
      "runtimeArgs": ["exec", "--", "pnpm", "exec", "vitest", "run"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}

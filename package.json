{
  "name": "ta-evidence",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check-types": "turbo run check-types",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:setup": "pnpm db:up",
    "db:migrate": "pnpm --filter @ta/db db:migrate",
    "db:generate": "pnpm --filter @ta/db db:generate",
    "db:studio": "pnpm --filter @ta/db db:studio",
    "db:seed": "pnpm --filter @ta/db db:seed",
    "setup-browsers": "pnpm --filter @ta/test run setup-browsers"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "turbo": "2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.18.0"
  }
}

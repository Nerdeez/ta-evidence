{
  "extends": "@ta/tsconfig/tsconfig.react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "resolvePackageJsonImports": true,
    "incremental": false
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}

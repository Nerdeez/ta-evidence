{
  "name": "@ta/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/utils": "./src/lib/utils.ts",
    "#lib/*": "./src/lib/*",
    "#lib/*/*": "./src/lib/*/*"
  },
  "exports": {
    "./globals.css": "./dist/styles/globals.css",
    "./css": "./dist/styles/css.css",
    "./card": {
      "types": "./dist/lib/card/card.d.ts",
      "import": "./dist/lib/card/card.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./lib/*/*": {
      "types": "./dist/lib/*/*.d.ts",
      "import": "./dist/lib/*/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/styles && cp src/styles/globals.css dist/styles/globals.css && cp src/styles/css.css dist/styles/css.css",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest --browser.headless=false"
  },
  "dependencies": {
    "@ta/theme": "workspace:*",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@ta/test": "workspace:*",
    "@ta/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  }
}

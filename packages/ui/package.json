{
  "name": "@ta/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#utils": "./src/utils.ts",
    "#/*": "./src/*",
    "#/*/*": "./src/*/*"
  },
  "exports": {
    "./globals.css": "./dist/styles/globals.css",
    "./tailwind.css": "./src/styles/tailwind.css",
    "./theme.css": "./src/styles/theme.css",
    "./css": "./dist/styles/css.css",
    "./breadcrumb": {
      "types": "./dist/breadcrumb/breadcrumb.d.ts",
      "import": "./dist/breadcrumb/breadcrumb.js"
    },
    "./card": {
      "types": "./dist/card/card.d.ts",
      "import": "./dist/card/card.js"
    },
    "./button": {
      "types": "./dist/button/button.d.ts",
      "import": "./dist/button/button.js"
    },
    "./input": {
      "types": "./dist/input/input.d.ts",
      "import": "./dist/input/input.js"
    },
    "./field": {
      "types": "./dist/field/field.d.ts",
      "import": "./dist/field/field.js"
    },
    "./label": {
      "types": "./dist/label/label.d.ts",
      "import": "./dist/label/label.js"
    },
    "./separator": {
      "types": "./dist/separator/separator.d.ts",
      "import": "./dist/separator/separator.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm run build:styles",
    "build:styles": "mkdir -p dist/styles && tailwindcss -i ./src/styles/globals.css -o ./dist/styles/globals.compiled.css",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/styles && cp src/styles/globals.css src/styles/tailwind.css src/styles/theme.css src/styles/css.css dist/styles/",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest --browser.headless=false"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "catalog:",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/cli": "catalog:",
    "@ta/test": "workspace:*",
    "@ta/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  }
}
